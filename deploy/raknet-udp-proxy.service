[Unit]
Description=RakNet status and UDP proxy for Bedrock NetherNet
After=network-online.target minecraft-bedrock-19132.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/raknet-udp-proxy.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
