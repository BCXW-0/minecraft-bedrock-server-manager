[Unit]
Description=Minecraft Bedrock Dedicated Server v26.51 (NetherNet TCP 10079 UDP 19132)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft-bedrock-19132
Environment=LD_LIBRARY_PATH=/opt/minecraft-bedrock-19132
ExecStart=/opt/minecraft-bedrock-19132/bedrock_server
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/minecraft-bedrock-19132
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
