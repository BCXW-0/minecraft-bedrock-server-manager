[Unit]
Description=Minecraft Bedrock public port forwarder
Wants=network-online.target
After=network-online.target
Before=minecraft-bedrock.service
PartOf=minecraft-bedrock.service

[Service]
Type=simple
User=minecraft
Group=minecraft
ExecStart=/usr/bin/python3 /usr/local/libexec/minecraft-bedrock-forward.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
